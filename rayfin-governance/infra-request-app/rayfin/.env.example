# Copy to .env and fill in. Never commit secrets.

# --- Local backend (rayfin dev) ---
# RAYFIN_API_URL=http://localhost:7071
# VITE_RAYFIN_API_URL=http://localhost:7071

# --- Deploy target (rayfin up) ---
# External tenant to deploy into. Omit to use your home tenant.
# FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
# Existing Fabric workspace this App is deployed into. Required to deploy.
# FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# Optional capacity backing the workspace.
# FABRIC_CAPACITY_ID=00000000-0000-0000-0000-000000000000
