# Purview Data Map account to read from (the short name, e.g. "ngpurview"
# for https://ngpurview.purview.azure.com). Required.
PURVIEW_ACCOUNT=ngpurview

# Optional: paste a pre-acquired Purview data-plane bearer token to skip
# DefaultAzureCredential / az CLI token acquisition (handy on locked-down
# Windows machines where SP data-plane auth is blocked).
#   az account get-access-token --resource https://purview.azure.net --query accessToken -o tsv
# PURVIEW_ACCESS_TOKEN=

# Optional: Azure subscription to scope the az token call to.
# AZURE_SUBSCRIPTION_ID=
