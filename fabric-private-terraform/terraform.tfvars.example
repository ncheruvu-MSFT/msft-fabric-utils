name_prefix = "fabpl"
location    = "eastus2"

# CAF env + instance — drive every resource name through naming.tf.
# Bump `instance` (01 -> 02) to recreate the stack with new names, which
# sidesteps the 24h Fabric capacity name reservation. See scripts/recreate.ps1.
environment = "demo"
instance    = "01"

# Used in firewall service-tag rules when capacity region differs from caller region.
paired_regions = ["centralus"]

# REQUIRED: Entra tenant ID that holds the Fabric tenant being private-linked.
fabric_tenant_id = "00000000-0000-0000-0000-000000000000"

# REQUIRED: Fabric capacity admins. Either UPNs (user@contoso.com) or service-principal/group object IDs.
capacity_admin_members = [
  "admin@contoso.onmicrosoft.com",
]

# Cheapest paid Fabric SKU.
capacity_sku = "F2"

# Toggle off if you only want network + capacity, no firewall.
enable_firewall   = true
firewall_sku_tier = "Standard"

# ---- Simulated on-prem lab (peered VNet + AD DS + DNS) ----
# Set to true to create a self-contained "fake on-prem" you can RDP into for
# end-to-end demos without needing a real ExpressRoute / VPN.
enable_simulated_onprem      = false
# onprem_admin_password      = "REPLACE_WITH_STRONG_PASSWORD"   # required when enabling
# onprem_admin_source_ip_cidr = "203.0.113.10/32"               # restrict RDP to your IP
# onprem_enable_public_ip    = true
# onprem_ad_domain_name      = "lab.contoso.local"
# onprem_ad_netbios_name     = "LAB"
# onprem_vm_size             = "Standard_B2ms"
